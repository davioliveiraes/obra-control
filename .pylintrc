# Optional Pylint configuration; Ruff remains the project's primary quality tool.
# Run from the repository root. No third-party Pylint plugins are required.

[MAIN]
py-version=3.14
source-roots=backend
ignore=.venv,migrations,__pycache__
persistent=no

[MESSAGES CONTROL]
# Keep small Django configuration/serializer classes and concise tests practical.
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    C0103, # invalid-name

[FORMAT]
max-line-length=88

[REPORTS]
reports=no
score=no
